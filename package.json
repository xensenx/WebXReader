{
  "name": "webxreader",
  "private": true,
  "version": "0.0.0",
  "description": "Free, open-source, ad-free, local-first web novel and ebook reader supporting 20 formats with offline reading.",
  "type": "module",
  "keywords": [
    "novel",
    "web-novel",
    "ebook-reader",
    "novel-reader",
    "open-source",
    "free",
    "ad-free",
    "offline-first",
    "local-first",
    "epub",
    "pdf",
    "mobi",
    "azw3",
    "fb2",
    "cbz",
    "cbr",
    "cb7",
    "djvu",
    "docx",
    "doc",
    "rtf",
    "txt",
    "markdown",
    "html",
    "mhtml",
    "zip",
    "rar",
    "png",
    "jpeg"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run build && vite preview"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "cfb": "^1.2.2",
    "djvu-rs": "^0.45.0",
    "dompurify": "^3.4.17",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
